{
  "name": "@local/dsh-plan-review-model",
  "version": "1.0.2",
  "private": true,
  "description": "Choose the current session's execution model when approving a Plan.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-user-questions", "@deepseek-ai/dsh-client-ui-plan", "@deepseek-ai/dsh-client-locale"]
    }
  }
}
